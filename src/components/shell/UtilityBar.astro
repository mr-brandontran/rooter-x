---
import { BUSINESS } from "@/config/business";
---

<div class="w-full bg-rx-blue text-white text-sm-rx font-body border-b border-white/10 py-2 px-4 sm:px-6 lg:px-8 z-40">
  <div class="max-w-7xl mx-auto flex items-center justify-between min-h-[32px]">
    <div></div>

    <!-- Right: Call Us & Email Us Pill Buttons matching screenshot -->
    <div class="flex items-center gap-3">
      <a
        href={BUSINESS.phoneHref}
        class="px-5 py-1.5 rounded-full border-2 border-white text-white font-serif font-medium text-sm-rx hover:bg-white hover:text-rx-blue transition-all duration-150 shadow-sm"
      >
        Call Us
      </a>
      <a
        href={`mailto:${BUSINESS.email}`}
        class="px-5 py-1.5 rounded-full border-2 border-white text-white font-serif font-medium text-sm-rx hover:bg-white hover:text-rx-blue transition-all duration-150 shadow-sm"
      >
        Email Us
      </a>
    </div>
  </div>
</div>
