---
import { BUSINESS } from "@/config/business";
import Button from "@/components/ui/Button.astro";

export interface Props {
  heading?: string;
  subheading?: string;
  idPrefix?: string;
  selectedService?: string;
  variant?: "default" | "blue";
}

const {
  heading = "Need a Quick Fix? We're Just a Message Away!",
  subheading = "",
  idPrefix = "form",
  selectedService = "",
  variant = "default"
} = Astro.props;

const services = [
  { name: "Camera inspection", slug: "camera-inspection" },
  { name: "Drain cleaning", slug: "drain-cleaning" },
  { name: "Hydro jetting", slug: "hydro-jetting" },
  { name: "Sewage pipe burst", slug: "sewage-pipe-burst" },
  { name: "Sewer line spot repairs", slug: "sewer-line-spot-repairs" },
  { name: "Epoxy pipe liner (CIPP)", slug: "epoxy-pipe-lining" },
  { name: "Boring", slug: "boring" },
  { name: "Repipe", slug: "repipe" },
  { name: "Water heaters installation", slug: "water-heater-installation" },
  { name: "Tankless installation", slug: "tankless-installation" },
  { name: "Leak detection", slug: "leak-detection" },
  { name: "New construction", slug: "new-construction" },
];

const isBlue = variant === "blue";
const cardClass = isBlue
  ? "p-0"
  : "bg-white border border-hairline rounded-[8px] p-6 sm:p-8 lg:p-10 shadow-sm";
const labelClass = isBlue
  ? "block text-sm-rx font-display font-semibold text-white mb-1.5"
  : "block text-sm-rx font-display font-semibold text-rx-ink mb-1.5";
const inputClass = isBlue
  ? "w-full px-4 py-3 text-base-rx rounded-[6px] border border-white/20 bg-white text-rx-ink focus-visible:outline-rx-blue"
  : "w-full px-4 py-3 text-base-rx rounded-[6px] border border-hairline bg-rx-paper text-rx-ink focus-visible:outline-rx-blue";
const headingClass = isBlue
  ? "text-2xl-rx sm:text-3xl-rx font-display font-bold text-white mb-2"
  : "text-xl-rx sm:text-2xl-rx font-display font-bold text-rx-ink mb-2";
const subClass = isBlue
  ? "text-base-rx text-white/90 measure-prose"
  : "text-base-rx text-rx-steel measure-prose";
---

<div class={cardClass} id={idPrefix}>
  <div class="mb-6">
    <h3 class={headingClass}>
      {heading}
    </h3>
    {subheading && (
      <p class={subClass}>
        {subheading}
      </p>
    )}
  </div>

  <form action="/api/contact" method="POST" class="space-y-4" data-contact-form>
    <!-- Hidden Honeypot for Bot Prevention -->
    <input type="text" name="website_url_check" class="hidden" tabindex="-1" autocomplete="off" />

    <!-- Name* -->
    <div>
      <label for={`${idPrefix}-name`} class={labelClass}>
        Name <span class={isBlue ? "text-white" : "text-rx-alert"}>*</span>
      </label>
      <input
        type="text"
        id={`${idPrefix}-name`}
        name="name"
        required
        autocomplete="name"
        placeholder="Full Name"
        class={inputClass}
      />
    </div>

    <!-- Phone* -->
    <div>
      <label for={`${idPrefix}-phone`} class={labelClass}>
        Phone <span class={isBlue ? "text-white" : "text-rx-alert"}>*</span>
      </label>
      <input
        type="tel"
        id={`${idPrefix}-phone`}
        name="phone"
        required
        autocomplete="tel"
        placeholder="(714) 323-3153"
        class={`${inputClass} font-mono`}
      />
    </div>

    <!-- Email* -->
    <div>
      <label for={`${idPrefix}-email`} class={labelClass}>
        Email Address <span class={isBlue ? "text-white" : "text-rx-alert"}>*</span>
      </label>
      <input
        type="email"
        id={`${idPrefix}-email`}
        name="email"
        required
        autocomplete="email"
        placeholder="email@example.com"
        class={inputClass}
      />
    </div>

    <!-- Service Needed* -->
    <div>
      <label for={`${idPrefix}-service`} class={labelClass}>
        Services Needed <span class={isBlue ? "text-white" : "text-rx-alert"}>*</span>
      </label>
      <select
        id={`${idPrefix}-service`}
        name="service"
        required
        class={inputClass}
      >
        <option value="">Select a service...</option>
        {services.map((svc) => (
          <option value={svc.slug} selected={selectedService === svc.slug}>
            {svc.name}
          </option>
        ))}
      </select>
    </div>

    <!-- Address -->
    <div>
      <label for={`${idPrefix}-address`} class={labelClass}>
        Address
      </label>
      <input
        type="text"
        id={`${idPrefix}-address`}
        name="address"
        autocomplete="street-address"
        placeholder="Street Address, City"
        class={inputClass}
      />
    </div>

    <!-- Time Preference -->
    <div>
      <label for={`${idPrefix}-time`} class={labelClass}>
        What time of the day do you prefer your appointment?
      </label>
      <select
        id={`${idPrefix}-time`}
        name="preferredTime"
        class={inputClass}
      >
        <option value="No preference">No Preference</option>
        <option value="Morning">Morning (8 AM - 12 PM)</option>
        <option value="Afternoon">Afternoon (12 PM - 4 PM)</option>
        <option value="Evening">Evening (4 PM - 8 PM)</option>
      </select>
    </div>

    <!-- Message -->
    <div>
      <label for={`${idPrefix}-message`} class={labelClass}>
        Message
      </label>
      <textarea
        id={`${idPrefix}-message`}
        name="message"
        rows="3"
        placeholder="How can we help you?"
        class={inputClass}
      ></textarea>
    </div>

    <!-- Live Announcement for Status -->
    <div id={`${idPrefix}-status`} class="sr-only" aria-live="polite"></div>

    <div class="pt-2">
      <Button type="submit" variant={isBlue ? "ink" : "blue"} class="w-full sm:w-auto px-8">
        Submit Request
      </Button>
    </div>
  </form>
</div>
